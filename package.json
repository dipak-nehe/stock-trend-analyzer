{
  "name": "stock-trend-analyzer",
  "private": true,
  "type": "module",
  "description": "Front end in TypeScript (src/, bundled by esbuild into public/js), its unit tests, the browser tests and the Allure report.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "lint": "oxlint",
    "lint:py": "sh -c 'R=.venv/bin/ruff; [ -x \"$R\" ] || R=ruff; \"$R\" check .'",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/js/tsconfig.json && tsc -p e2e/tsconfig.json",
    "typecheck:py": "sh -c 'M=.venv/bin/mypy; [ -x \"$M\" ] || M=mypy; \"$M\"'",
    "check": "npm run lint && npm run lint:py && npm run typecheck && npm run typecheck:py",
    "test": "node --test tests/js/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 tests/js/*.test.ts",
    "test:js:allure": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/js/allure-reporter.mjs --test-reporter-destination=stdout tests/js/*.test.ts",
    "report": "allure generate allure-results",
    "report:open": "allure open allure-report",
    "load": "sh load/run-local.sh",
    "load:ui": "SCRIPT=load/ui-ramp.js REPORT=load/ui-report.html sh load/run-local.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "allure": "3.21.0",
    "allure-js-commons": "3.13.0",
    "allure-playwright": "3.13.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
