{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/financials.py": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    },
    "api/insiders.py": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    },
    "api/search.py": {
      "includeFiles": "backend/**",
      "maxDuration": 10
    },
    "api/page.py": {
      "includeFiles": "{backend/**,public/index.html,public/data/sp500.json}",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/stock/:ticker",
      "destination": "/api/page?ticker=:ticker"
    }
  ]
}
